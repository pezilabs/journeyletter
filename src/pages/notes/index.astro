---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PieceList from '../../components/PieceList.astro';
import { pieces } from '../../pieces';

const items = await pieces(['notes']);
---
<Base
  title="Notes · Journeyletter"
  description="Field notes on operating AI agents for real work, from a publication that is itself run as an agent operation. It publishes when something real happened."
  crumbs={[{ href: '/writing/', label: 'Journeyletter' }, { label: 'Notes' }]}
>
  <PageHead num="Writing" label="Journeyletter" title="Notes" lede="Field notes on operating AI agents for real work, from a publication that is itself run as an agent operation. It publishes when something real happened." />
  <section class="section" style="padding-top:var(--s6)">
    <div class="wrap">
      <PieceList items={items} />
      <div class="idx-foot mono"><span>RSS: <a href="/notes/rss.xml">/notes/rss.xml</a></span><a href="/writing/">All writing <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
  </section>
</Base>
