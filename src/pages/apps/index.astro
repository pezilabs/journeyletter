---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Block from '../../components/Block.astro';
import UseCaseIndex from '../../components/UseCaseIndex.astro';
import { useCases } from '../../usecases';

const household = await useCases('household');
---
<Base
  title="Household applications · Pezi Labs"
  description="Software built for the specific needs of the people in one home, running privately in that home."
>
  <PageHead
    num="Apps"
    label="Use cases"
    title="Household applications"
    lede="Software built for the specific needs of the people in one home."
  />

  <Block num="01" label="What they are" title="Built by the person closest to the need" id="h-what">
    <p>
      The enterprise world has started calling these personal web applications. The idea is the
      same: someone who understands the material, the space and the need can now build the tool.
      Every project here is a use case: a real need, what I built for it, and what changed.
    </p>
    <p>
      Mine run on a computer in my house and are reachable only over a private network. They're
      not on the internet, on purpose. The people who use them are my family, and their data
      stays home. If you want to see one running, <a href="/about/#contact">ask me</a> and I'll
      show you.
    </p>
  </Block>

  <section class="section" aria-labelledby="h-index">
    <div class="wrap">
      <div class="grid section-head">
        <div class="c-label label mono"><b>02</b><span>Index</span></div>
        <h2 id="h-index" class="c-main h2">Use cases</h2>
      </div>
      <UseCaseIndex items={household} />
      <div class="idx-foot mono"><span>Grouped by status. Retired work stays listed.</span></div>
    </div>
  </section>
</Base>
