---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PieceList from '../../components/PieceList.astro';
import { pieces } from '../../pieces';

const items = await pieces(['letters']);
---
<Base
  title="Letters · Journeyletter"
  description="The hand-first lane. A letter starts as my own draft and gets structured, not generated from exhaust."
  crumbs={[{ href: '/writing/', label: 'Journeyletter' }, { label: 'Letters' }]}
>
  <PageHead num="Writing" label="Journeyletter" title="Letters" lede="The hand-first lane. A letter starts as my own draft and gets structured, not generated from exhaust." />
  <section class="section" style="padding-top:var(--s6)">
    <div class="wrap">
      <PieceList items={items} />
      <div class="idx-foot mono"><span>RSS: <a href="/letters/rss.xml">/letters/rss.xml</a></span><a href="/writing/">All writing <span class="arrow" aria-hidden="true">→</span></a></div>
    </div>
  </section>
</Base>
