---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const usecases = await getCollection('usecases');
const household = usecases.filter((uc) => uc.data.line === 'household');
const becoming = household.filter((uc) => uc.data.status === 'productizing');
const notes = await getCollection('notes');
const letters = await getCollection('letters');

// Counts are only worth stating once they say something. Below that, the
// doors describe the work instead of numbering it.
const showCount = household.length >= 10;

const recent = [
  ...usecases.map((uc) => ({
    date: uc.data.published,
    title: uc.data.title,
    href: `/${uc.data.line === 'household' ? 'apps' : 'services'}/${uc.id}/`,
    kind: 'Use case',
  })),
  ...notes.map((n) => ({ date: n.data.date, title: n.data.title, href: `/notes/${n.id}/`, kind: 'Note' })),
  ...letters.map((l) => ({ date: l.data.date, title: l.data.title, href: `/letters/${l.id}/`, kind: 'Letter' })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Pezi Labs"
  description="A one-person studio run by Tom Murphy. Software built from real needs, starting at home."
>
  <section class="opening">
    <h1 class="visually-hidden">Pezi Labs</h1>
    <p>
      Pezi Labs is my one-person studio. I'm Tom Murphy. For 25 years my job has started the
      same way: sitting with the people who have the problem, listening until I understand what
      they actually need, then sketching, prototyping and showing them something real.
    </p>
    <p>
      That part hasn't changed. What changed is that now I build the whole thing. Right now I
      build it for my own household, and the best of it is becoming products.
    </p>
  </section>

  <section class="doors">
    <div>
      <h2><a href="/apps/">Household applications</a></h2>
      <p>
        Small, specific apps for the people I live with, running privately on a computer in my
        house.
        {showCount
          ? ` ${household.length} use cases so far, ${becoming.length} becoming products.`
          : ` ${becoming.length === 1 ? 'One is' : `${becoming.length} are`} becoming a product.`}
      </p>
    </div>
    <div>
      <h2><a href="/services/">Services</a></h2>
      <p>
        I work with owner-run businesses on the problems behind the website: bookings,
        inventory, the spreadsheet everyone is afraid to touch.
      </p>
    </div>
    <div>
      <h2><a href="/writing/">Writing</a></h2>
      <p>
        The Journeyletter. Field notes on running AI agents for real work, and letters I draft
        by hand. {notes.length + letters.length} pieces so far.
      </p>
    </div>
  </section>

  <section>
    <h2>Recent</h2>
    <ul class="piece-list">
      {recent.map((item) => (
        <li>
          <span class="piece-date">{fmt.format(item.date)} · {item.kind}</span>
          <a class="piece-title" href={item.href}>{item.title}</a>
        </li>
      ))}
    </ul>
  </section>

  <p><a href="/about/">More about me and how I work.</a></p>
</Base>
