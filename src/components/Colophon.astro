---
// The Journeyletter's signature: structured provenance at the end of every
// piece, set as a spec sheet.
interface Props {
  colophon: {
    stack: string[];
    agents: { name: string; role: string }[];
    human: { name: string; role: string };
  };
}
const { colophon } = Astro.props;
---
<aside class="colophon mono" aria-label="Colophon">
  <div class="spec-h"><a href="/writing/about/#colophons">Colophon</a><span>Who did what</span></div>
  <dl>
    <dt>Stack</dt>
    <dd>{colophon.stack.join(' · ')}</dd>
    {colophon.agents.map((agent) => (
      <>
        <dt>Agent<span class="who">{agent.name}</span></dt>
        <dd>{agent.role}</dd>
      </>
    ))}
    <dt>Human<span class="who">{colophon.human.name}</span></dt>
    <dd>{colophon.human.role}</dd>
  </dl>
</aside>
