---
// A numbered section on a plain page: mono label in columns 1–3,
// heading and copy in 4–12.
interface Props {
  num: string;
  label: string;
  title: string;
  id?: string;
}
const { num, label, title, id } = Astro.props;
---
<section class="section" aria-labelledby={id}>
  <div class="wrap">
    <div class="grid block">
      <div class="c-label label mono"><b>{num}</b><span>{label}</span></div>
      <h2 id={id} class="h2">{title}</h2>
      <div class="copy"><slot /></div>
    </div>
  </div>
</section>
