---
interface Props {
  num: string;
  label: string;
  title: string;
  lede?: string;
}
const { num, label, title, lede } = Astro.props;
---
<section class="page-head">
  <div class="wrap">
    <div class="grid">
      <div class="label mono"><b>{num}</b><span>{label}</span></div>
      <h1 class="page-title">{title}</h1>
      {lede && <p class="page-lede">{lede}</p>}
    </div>
  </div>
</section>
